{
  "name": "catch-push",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catch-push-db",
      "database_id": "PUT_YOUR_D1_DATABASE_ID_HERE"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://ogasharou.github.io"
  }
}
